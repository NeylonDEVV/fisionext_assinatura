DATABASE_URL="file:./dev.db"
# Gere uma chave própria: openssl rand -base64 32  (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria"
# Opcional: credenciais do usuário criado pelo seed
# SEED_ADMIN_EMAIL="admin@fisionext.com"
# SEED_ADMIN_PASSWORD="fisio1234"

# Cobrança (Asaas). Veja docs/ASAAS.md.
# Cole a chave SEM o "$" inicial (o sistema acrescenta): $aact_hmlg_XXXX vira aact_hmlg_XXXX
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
# Token do webhook: 32+ caracteres aleatórios (não pode ser a chave da API)
ASAAS_WEBHOOK_TOKEN=""

# Página pública (landing). Veja docs/LANDING.md.
SITE_WHATSAPP=""      # com DDI e DDD, só números. Ex.: 5561999999999
SITE_EMAIL=""
SITE_SHOW_PRICING="false"   # "true" mostra a seção de planos (valores em src/lib/plans.ts)

# Cadastro público (/cadastro). Só ligue depois de ter Termos de uso e Política de privacidade revisados.
SIGNUP_ENABLED="false"
TRIAL_DAYS="14"
