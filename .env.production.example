# Copie para .env.production e preencha.
DOMAIN=app.suaclinica.com.br
# Gere com: openssl rand -base64 32   (mínimo 32 caracteres)
AUTH_SECRET=

# Cobrança (Asaas): veja docs/ASAAS.md. Use sandbox até validar tudo; depois ASAAS_ENV=production.
ASAAS_ENV=sandbox
# Chave SEM o "$" inicial (o sistema acrescenta)
ASAAS_API_KEY=
# 32+ caracteres aleatórios (openssl rand -hex 24)
ASAAS_WEBHOOK_TOKEN=

# Página pública (landing): veja docs/LANDING.md.
SITE_WHATSAPP=
SITE_EMAIL=
SITE_SHOW_PRICING=false

# Cadastro público (/cadastro): só "true" depois de ter Termos de uso e Política de privacidade revisados por um advogado.
SIGNUP_ENABLED=false
TRIAL_DAYS=14
